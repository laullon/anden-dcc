(text "01A - USB-C PD negotiation core / FOR REVIEW" (at 20.32 20.32 0) (effects (font (size 2 2)) (justify left)) (uuid cccd9041-b1cb-4dc9-9d2e-d8e52ee40ace))
(text "EXPERIMENTAL / DESIGN ONLY - protection and load path still pending" (at 20.32 27.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 59fa1dcb-6c56-4565-8aa5-526ef4f27664))
(text "15 V request: R2 = 56k; leave CFG2 and CFG3 open. No MCU boot dependency." (at 20.32 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 92183f6b-00db-4063-b665-da6bdb178ac8))
(text "PD-only: short U1 DP/DM locally; U1 VBUS sense intentionally NC (WCH section 5.5)." (at 20.32 119.38 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 3559ac86-5848-4a0d-9fd3-3f548f7d1057))
(text "U1 exposed GND pad: KiCad pin 11 maps datasheet pad 0. Must be soldered." (at 20.32 127 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid c5b26faa-8ac5-42c6-afbb-b7f3ffbe816c))
(text "R1 worst case at 20 V / 3.0 V VDD: (20 - 3)^2 / 1k = 0.289 W; use 0.5 W minimum." (at 20.32 134.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a4f3a33b-eb84-44a1-847d-ed31dcc60b38))
(text "USB_VBUS_RAW starts at 5 V and may fall back. PG is status, not a 15 V interlock." (at 20.32 142.24 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid f1b3f764-deb8-4dd9-b73b-5dcc1bd13c79))
(text "Next review: fuse / OVP / CC ESD / inrush-limited load path before bulk capacitance." (at 20.32 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 707f25f7-8f00-42a8-8d54-abce8babe8c6))
(text "J3 uses logical USB contact names; GCT USB4750 physical mapping and footprint UNVERIFIED." (at 20.32 157.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 426c47ce-266b-45f7-b820-8f2fc26e5e96))
(text "No downstream load or protection is connected yet. No footprints assigned on this sheet." (at 20.32 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 9b0b2621-3ce3-4132-b0e3-6a394c1249ee))
(text "Source: WCH CH224 datasheet v1F, sections 4.3, 5.2.1, 5.5 and 6.1. See review notes." (at 20.32 172.72 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid ac5a25df-beb4-45df-b7d6-09c1c1b2cd6e))
)
